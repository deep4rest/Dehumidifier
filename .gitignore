# 本地环境、Agent 配置和缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.tmp/
.fonts/
*.egg-info/
.env
.env.*
!.env.example
/.claude/
/.codex/

# 运行与历史产物只在本机保留；源码上传必须创建无旧历史的快照。
/artifacts/*
!/artifacts/README.md
/results/*
!/results/README.md
/archive/artifacts/
/dist/
/workspaces/
/deployment/dotnet/src/Dehumidifier.Simulation/models/

# 原始数据和企业表格带外移交，不上传 GitHub。
*.xls
*.xlsx
*.csv
*.parquet
*.npy
*.npz

# 模型、检查点、图像、日志及封装二进制
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.onnx
*.onnx.data
*.dll
*.exe
*.so
*.dylib
*.pdb
*.nupkg
*.snupkg
*.zip
*.tar
*.gz
*.7z
*.png
*.jpg
*.jpeg
*.pdf
*.docx
*.log
*.jsonl

# .NET/Python 构建输出；下方例外中的 MSBuild targets 是必须保留的源码。
bin/
obj/
build/
dist/
packages/
.nuget/
!/deployment/dotnet/src/Dehumidifier.Simulation/build/
!/deployment/dotnet/src/Dehumidifier.Simulation/build/*.targets
